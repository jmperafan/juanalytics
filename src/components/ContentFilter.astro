---
interface Props {
  tags: string[];
  gridId: string;
  cardClass: string;
}

const { tags, gridId, cardClass } = Astro.props;
const uniqueTags = Array.from(new Set(tags)).sort((a, b) => a.localeCompare(b));
---

<div class="sidebar-filters">
  <div class="filters-sticky">
    <h3 class="filter-header" id={`${gridId}-filter-label`}>Filter by tag</h3>
    <div class="filter-buttons" role="group" aria-labelledby={`${gridId}-filter-label`}>
      <button class="filter-tag active" data-tag="all" aria-pressed="true">All</button>
      {uniqueTags.map((tag) => (
        <button class="filter-tag" data-tag={tag} aria-pressed="false">{tag}</button>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ gridId, cardClass }}>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-tag');
    const cards = document.querySelectorAll(`.${cardClass}`);
    const contentTags = document.querySelectorAll('.content-tag');

    function filterByTag(tag) {
      // Update active button
      filterButtons.forEach(btn => {
        const isActive = btn.getAttribute('data-tag') === tag;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // Filter cards
      cards.forEach(card => {
        const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        if (tag === 'all' || cardTags.includes(tag)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      // Scroll to top of results
      document.getElementById(gridId)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Filter button clicks
    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = btn.getAttribute('data-tag') || 'all';
        filterByTag(tag);
      });
    });

    // Content tag clicks
    contentTags.forEach(tag => {
      tag.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tagName = tag.getAttribute('data-tag') || '';
        filterByTag(tagName);
      });
    });
  });
</script>

<style>
  .sidebar-filters {
    width: 100%;
  }

  .filter-header {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .filter-buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-tag {
    background: var(--color-bg-secondary);
    color: var(--color-text);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background-color var(--dur) var(--ease);
    text-align: left;
  }

  .filter-tag:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-tag.active {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 480px) {
    .filter-tag {
      padding: 0.35rem 0.75rem;
      font-size: 0.775rem;
    }
  }
</style>
